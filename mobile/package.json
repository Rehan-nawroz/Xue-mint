{
  "name": "@xue-mint/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Xue-Mint Android app: phone backup and PC library over the local network",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src e2e",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "cap:sync": "npm run build && cap sync android",
    "cap:add:android": "cap add android",
    "cap:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@xue-mint/shared": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "4.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.14.0",
    "tailwindcss": "4.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.3.0"
  }
}
